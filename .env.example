# Настройки публикации в VK.
#
# Скопируйте файл как `.env` в корне проекта и заполните значения.
# Сам `.env` добавлен в .gitignore и в репозиторий не попадает.
# Ни один из этих параметров не зашит в код: приложение читает их
# только отсюда.

# Идентификатор сообщества (группы). Только цифры.
# Можно указать и ссылку (https://vk.com/club123456) — приложение
# возьмёт из неё цифры.
VK_GROUP_ID=

# Ключ доступа СООБЩЕСТВА с правом на записи (wall).
# Управление сообществом -> Настройки -> Работа с API -> Создать ключ.
# Это единственный секрет в проекте: он не попадает в HTML, JavaScript,
# логи и ответы приложения.
VK_ACCESS_TOKEN=

# Версия VK API. Менять без необходимости не нужно.
# Актуальная версия: https://dev.vk.com/ru/reference/version/5.199
VK_API_VERSION=5.199

# Адрес сайта, который ставится в конце поста вместо локального.
# Должен начинаться с http:// или https:// и не заканчиваться слешем.
SITE_URL=http://localhost:5000

# --- Необязательные параметры -------------------------------------------------
# Убрать значения, если хотите оставить значения по умолчанию.

# Таймаут HTTP-запроса к VK, секунды.
# VK_TIMEOUT=10

# Сколько данных вакансии попадает в один пост.
# VK_MAX_REQUIREMENTS=6
# VK_MAX_MATCHES=5
# VK_MAX_MISSING=5
# VK_MAX_POST_CHARS=4000
